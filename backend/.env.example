# Backend
PORT=4000
NODE_ENV=development

# SQLite local / PostgreSQL en production
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — exemple :
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ivoire_gaming?schema=public"

JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
ACCESS_TOKEN_TTL=900            # 15 min en secondes
REFRESH_TOKEN_TTL_DAYS=7

# CORS — origines autorisées (mobile Expo/Expo Go)
CORS_ORIGIN="*"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# Push notifications (Expo) — 0 = désactivé
EXPO_PUSH_ENABLED=0

# LiveKit (voix/appels). Vide = mode "simulation" (les salons fonctionnent en données/temps réel, sans flux audio réel)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""